# Copy to .env and fill in. Never commit .env, and never put real keys in this file.

# Jina AI (embeddings + reranker). Needed from Phase 2 (index build, search).
JINA_API_KEY=

# Groq (agent LLM, free tier). Needed from Phase 3.
GROQ_API_KEY=

# Postgres + pgvector (matches docker-compose.yml)
POSTGRES_USER=statnav
POSTGRES_PASSWORD=statnav
POSTGRES_DB=statnav
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# LangSmith tracing (optional, off unless set to true). Uploads questions, passages and answers.
# Never traced: tests and evals. Do not add LANGSMITH_PROJECT: beside the agent vars it stops tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=
